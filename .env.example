# At least one backend is required. Prefer real secrets via the environment or
# GitHub secrets — leave these blank in the repo (blank means unset).
# Pushover is enabled only when both values are non-empty.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Optional Pushover endpoint override (default https://api.pushover.net/1/messages.json)
# PUSHOVER_URL=

# ntfy is enabled when NTFY_TOPIC is non-empty. It can be the only backend.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Default timeout (seconds) when a device entry omits an explicit timeout
HEARTBEAT_TIMEOUT_SECS=90

# How often to scan devices for staleness (seconds)
CHECK_INTERVAL_SECS=10

# Minimum seconds between repeat outage alerts while heartbeats are still missing.
# The scan interval stays CHECK_INTERVAL_SECS; this does not reset the outage clock.
DEBOUNCE_SECS=300

# Comma-separated devices to monitor, each optionally with a per-device timeout:
#   device_id[:timeout_secs],...
# Examples:
#   HEARTBEAT_DEVICES=poop
#   HEARTBEAT_DEVICES=poop:90,fridge:120,server
HEARTBEAT_DEVICES=poop:90
HEARTBEAT_SECRET=REPLACE_ME
