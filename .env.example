# --- Notification backends (at least one required) ---

# Pushover (https://pushover.net/)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ntfy (https://ntfy.sh/) — optional second channel
# NTFY_TOPIC=my-alerts
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# --- Heartbeat watcher ---
HEARTBEAT_TIMEOUT_SECS=90
CHECK_INTERVAL_SECS=10
DEBOUNCE_SECS=300

# Logging (env_logger)
# RUST_LOG=info
